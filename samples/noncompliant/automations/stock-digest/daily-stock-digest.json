{
  "name": "Daily stock digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "00000001-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "stock_balances",
        "returnAll": true
      },
      "id": "00000002-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "name": "Stock balances",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "sb01",
          "name": "Stock database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst low = rows.filter(r => r.pieces <= r.reorder_level);\nconst soon = rows.filter(r => r.days_to_expiry !== null && r.days_to_expiry <= 60);\nconst lines = [];\nlow.forEach(r => lines.push(`LOW ${r.warehouse} ${r.project} ${r.item}: ${r.pieces} pieces`));\nsoon.forEach(r => lines.push(`EXPIRY ${r.warehouse} ${r.project} ${r.item}: ${r.days_to_expiry} days`));\nreturn [{json: {count: lines.length, body: lines.join(\"\\n\")}}];"
      },
      "id": "00000003-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "00000004-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "name": "Anything to report",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "channel": "#supply-chain",
        "accessToken": "stk-demo-7f3a91c2d4e8b605",
        "text": "={{ $json.body }}"
      },
      "id": "00000005-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "name": "Post to chat",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "slackApi": {
          "id": "sl01",
          "name": "Chat bot"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
